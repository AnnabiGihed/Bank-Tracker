<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Tests of KbcTracker.Components with bUnit, against a stubbed backend. Test packages and settings come from
    test/Directory.Build.props. The stub backend and the invented workspace are the ones of the view model tests,
    linked rather than copied so they cannot drift apart.
  -->
