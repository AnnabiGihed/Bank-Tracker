    <PackageReference Include="bunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\..\..\src\Containers\UI\Core\KbcTracker.Components\KbcTracker.Components.csproj" />
  </ItemGroup>

  <ItemGroup Label="Shared test doubles of the view model tests">
    <Compile Include="..\KbcTracker.ViewModels.Tests\Features\Shared\StubBackend.cs" Link="Features\Shared\StubBackend.cs" />
    <Compile Include="..\KbcTracker.ViewModels.Tests\Features\Shared\TestWorkspace.cs" Link="Features\Shared\TestWorkspace.cs" />
  </ItemGroup>

  <ItemGroup Label="Feature namespaces used across the project">
