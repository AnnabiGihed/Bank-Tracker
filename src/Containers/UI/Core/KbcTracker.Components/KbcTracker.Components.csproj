<Project Sdk="Microsoft.NET.Sdk.Razor">

  <!--
    The Razor components of both front ends (ADR-0008), built with Radzen.Blazor on top of the view models. Shared by
    the web app (Interactive Server) and the Android app (MAUI Blazor Hybrid). Build settings come from
    Directory.Build.props.
  -->
  <PropertyGroup>
    <RootNamespace>KbcTracker.Components</RootNamespace>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" />
    <PackageReference Include="Radzen.Blazor" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\KbcTracker.ViewModels\KbcTracker.ViewModels.csproj" />
  </ItemGroup>

  <ItemGroup Label="Feature namespaces used across the project">
    <Using Include="KbcTracker.Application.Features.BankConnection.Consent" />
    <Using Include="KbcTracker.Application.Features.Workspace.Contracts" />
    <Using Include="KbcTracker.Domain.Features.Categories.ValueObjects" />
    <Using Include="KbcTracker.Domain.Features.FixedPayments.ValueObjects" />
    <Using Include="KbcTracker.Domain.Features.Shared.Services" />
    <Using Include="KbcTracker.Shared.Features.Backend" />
    <Using Include="KbcTracker.ViewModels.Features.BankConnection" />
    <Using Include="KbcTracker.ViewModels.Features.Categories" />
    <Using Include="KbcTracker.ViewModels.Features.FixedPayments" />
    <Using Include="KbcTracker.ViewModels.Features.Overview" />
    <Using Include="KbcTracker.ViewModels.Features.Review" />
    <Using Include="KbcTracker.ViewModels.Features.Settings" />
    <Using Include="KbcTracker.ViewModels.Features.Shared" />
    <Using Include="KbcTracker.ViewModels.Features.Transactions" />
    <Using Include="KbcTracker.Components.Features.BankConnection" />
    <Using Include="KbcTracker.Components.Features.Categories" />
    <Using Include="KbcTracker.Components.Features.FixedPayments" />
    <Using Include="KbcTracker.Components.Features.Overview" />
    <Using Include="KbcTracker.Components.Features.Review" />
    <Using Include="KbcTracker.Components.Features.Settings" />
    <Using Include="KbcTracker.Components.Features.Shared" />
    <Using Include="KbcTracker.Components.Features.Shared.Layout" />
    <Using Include="KbcTracker.Components.Features.Shared.Pickers" />
    <Using Include="KbcTracker.Components.Features.Transactions" />
    <Using Include="Microsoft.AspNetCore.Components" />
    <Using Include="Microsoft.AspNetCore.Components.Routing" />
    <Using Include="Microsoft.AspNetCore.Components.Web" />
    <Using Include="Radzen" />
    <Using Include="Radzen.Blazor" />
  </ItemGroup>

</Project>
