<Project Sdk="Microsoft.NET.Sdk">

  <!--
    What the user interfaces share (ADR-0004): the typed client of the backend's API and its registration. It references the application
    project only for the API contracts, never for storage or the bank. Build settings come from Directory.Build.props.
  -->
  <PropertyGroup>
    <RootNamespace>KbcTracker.Shared</RootNamespace>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../../../Core/KbcTracker.Application/KbcTracker.Application.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- AddHttpClient for the typed backend client (ADR-0008). -->
    <PackageReference Include="Microsoft.Extensions.Http" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="KbcTracker.Shared.Features.Backend" />
  </ItemGroup>

</Project>
