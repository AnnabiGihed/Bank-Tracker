<!DOCTYPE html>
<html lang="en">
<head>
	<meta charset="utf-8" />
	<meta name="viewport" content="width=device-width, initial-scale=1" />
	<title>Sign in - KBC Tracker</title>
	<style>
		body { font-family: system-ui, sans-serif; display: grid; place-items: center; min-height: 100vh; margin: 0; background: #f5f5f5; color: #222; }
		main { background: #fff; padding: 2rem 2.5rem; border-radius: 8px; border: 1px solid #ddd; min-width: 18rem; }
		h1 { font-size: 1.25rem; margin-top: 0; }
		a.provider { display: block; margin: 0.5rem 0; padding: 0.6rem 1rem; border: 1px solid #888; border-radius: 6px; color: inherit; text-decoration: none; text-align: center; }
		a.provider:focus-visible, a.provider:hover { outline: 2px solid #1a56db; }
		.error { color: #a00; }
	</style>
</head>
<body>
	<main>
		<h1>KBC Tracker</h1>
		@if (Failed)
		{
			<p class="error" role="alert">Sign-in failed or this account is not allowed. Try again.</p>
		}
		@if (Providers.Count == 0)
		{
			<p role="alert">No sign-in provider is configured (setting SignIn:Providers).</p>
		}
		@foreach (var provider in Providers)
		{
			<a class="provider" href="@StartAddress(provider)">Sign in with @provider</a>
		}
	</main>
</body>
</html>
