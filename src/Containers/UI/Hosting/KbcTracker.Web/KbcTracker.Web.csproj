<Project Sdk="Microsoft.NET.Sdk.Web">

  <!--
    The web UI (ADR-0004, ADR-0008): a Blazor Web App (Interactive Server) that hosts the shared components, which read
    and change everything through the backend's API. It stores no data and holds no bank key.
    Build settings and analyzers come from Directory.Build.props.
  -->
  <PropertyGroup>
    <RootNamespace>KbcTracker.Web</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\..\Core\KbcTracker.Application\KbcTracker.Application.csproj" />
    <ProjectReference Include="..\..\Core\KbcTracker.Shared\KbcTracker.Shared.csproj" />
    <ProjectReference Include="..\..\Core\KbcTracker.ViewModels\KbcTracker.ViewModels.csproj" />
    <ProjectReference Include="..\..\Core\KbcTracker.Components\KbcTracker.Components.csproj" />
    <ProjectReference Include="..\..\..\Aspire\Defaults\KbcTracker.ServiceDefaults\KbcTracker.ServiceDefaults.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="KbcTracker.E2E.Tests" />
  </ItemGroup>

  <ItemGroup Label="Feature namespaces used across the project">
    <Using Include="KbcTracker.Components.Features.Shared" />
    <Using Include="KbcTracker.Components.Features.Shared.Layout" />
    <Using Include="KbcTracker.ViewModels.Features.Shared" />
    <Using Include="KbcTracker.Web.Features.Shared.Api" />
    <Using Include="KbcTracker.Web.Features.Shared.Shell" />
    <Using Include="Microsoft.AspNetCore.Components" />
  </ItemGroup>

</Project>
