<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The use cases of KbcTracker (ADR-0004) as mediator commands and queries: sync, bank consent, the workspace and the
    user's decisions, with the ports to storage and to the bank. Depends on the domain and Pivot.Framework only.
    Build settings come from Directory.Build.props.
  -->
  <PropertyGroup>
    <RootNamespace>KbcTracker.Application</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- ILogger for SyncService; every host provides an implementation. -->
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Pivot.Framework.Application" />
  </ItemGroup>

  <ItemGroup>
    <!-- The handlers are internal; their unit tests reach them directly. -->
    <InternalsVisibleTo Include="KbcTracker.Application.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\KbcTracker.Domain\KbcTracker.Domain.csproj" />
  </ItemGroup>

  <ItemGroup Label="Feature namespaces used across the project">
    <Using Include="KbcTracker.Application.Features.BankConnection.Abstractions" />
    <Using Include="KbcTracker.Domain.Features.BankConnection.Aggregates" />
    <Using Include="KbcTracker.Domain.Features.Categories.Aggregates" />
    <Using Include="KbcTracker.Domain.Features.Shared.Aggregates" />
    <Using Include="KbcTracker.Domain.Features.Transactions.Aggregates" />
  </ItemGroup>

</Project>
