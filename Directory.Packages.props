<Project>
  <!-- Central package versions (Static Analysis and Quality Gates / R2): PackageReference items carry no Version. -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup Label="Analyzers (ADR-0002)">
    <PackageVersion Include="Meziantou.Analyzer" Version="3.0.317" />
    <PackageVersion Include="SonarAnalyzer.CSharp" Version="10.35.0.4138" />
    <PackageVersion Include="StyleCop.Analyzers" Version="1.3.151-beta" />
  </ItemGroup>
  <ItemGroup Label="Libraries">
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.13" />
    <PackageVersion Include="Pivot.Framework.Domain" Version="2.1.0" />
    <PackageVersion Include="Pivot.Framework.Application" Version="2.1.0" />
    <PackageVersion Include="Pivot.Framework.Containers.API" Version="2.1.0" />
    <PackageVersion Include="Pivot.Framework.Infrastructure.Messaging.EntityFrameworkCore" Version="2.1.0" />
    <PackageVersion Include="Pivot.Framework.Infrastructure.Persistence.EntityFrameworkCore" Version="2.1.0" />
    <PackageVersion Include="Pivot.Framework.Infrastructure.Persistence.PostgreSQL" Version="2.1.0" />
    <!-- Design-time only (migrations); pinned to the EF Core version the Pivot packages resolve (ADR-0004). -->
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.13" />
    <!-- Security pin: Pivot's messaging package brings 2.3.12 through Microsoft.AspNetCore.Http 2.3.13, which
         CVE-2026-118750 (GHSA-6527-9fp8-r4x6, denial of service) affects up to 2.3.13. Remove once Pivot resolves
         2.3.14 or later itself. -->
    <PackageVersion Include="Microsoft.AspNetCore.WebUtilities" Version="2.3.14" />
  </ItemGroup>
  <ItemGroup Label="Aspire (ADR-0005)">
    <PackageVersion Include="Aspire.Hosting.PostgreSQL" Version="13.6.5" />
    <!-- OpenTelemetry pinned to the version Pivot.Framework.Containers.API 2.1.0 resolves, so the API sees one version. -->
    <PackageVersion Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.20.1" />
    <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="1.20.1" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.20.1" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Http" Version="1.20.1" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Runtime" Version="1.20.1" />
  </ItemGroup>
  <ItemGroup Label="Front ends (ADR-0008)">
    <!-- Radzen component library of the shared Razor components; one version for the web app and the Android app. -->
    <PackageVersion Include="Radzen.Blazor" Version="12.1.8" />
    <!-- MAUI Blazor Hybrid shell of the Android app. -->
    <PackageVersion Include="Microsoft.Maui.Controls" Version="10.0.120" />
    <PackageVersion Include="Microsoft.AspNetCore.Components.WebView.Maui" Version="10.0.120" />
    <!-- AddHttpClient for the typed backend client, and the component model for the Razor class library; both at
         the 10.0 patch of the SDK. -->
    <PackageVersion Include="Microsoft.Extensions.Http" Version="10.0.14" />
    <PackageVersion Include="Microsoft.AspNetCore.Components.Web" Version="10.0.14" />
  </ItemGroup>
  <ItemGroup Label="Tests (ADR-0003: the stack of Pivot.Framework's own tests)">
    <PackageVersion Include="Aspire.Hosting.Testing" Version="13.6.5" />
    <PackageVersion Include="AwesomeAssertions" Version="9.6.0" />
    <PackageVersion Include="bunit" Version="2.13.3" />
    <PackageVersion Include="coverlet.collector" Version="10.1.0" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.13" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageVersion Include="Microsoft.Playwright" Version="1.64.1" />
    <PackageVersion Include="NSubstitute" Version="5.3.0" />
    <PackageVersion Include="Testcontainers.PostgreSql" Version="4.15.0" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.1" />
  </ItemGroup>
</Project>