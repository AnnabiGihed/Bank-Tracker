<?xml version="1.0" encoding="utf-8"?>
<!--
  The complete package source set of this project. <clear /> deliberately drops sources from the machine-wide
  configuration (for example work feeds that need credentials), so restore behaves the same on every machine.

  Pivot.Framework packages come only from the author's GitHub Packages feed (package source mapping); everything
  else only from nuget.org. The feed needs a GitHub token with read:packages, read from environment variables at
  restore time: set PIVOT_PACKAGES_USER (the GitHub user) and PIVOT_PACKAGES_TOKEN (for example `gh auth token`).
  Never write the token into this file. See ADR-0003.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    <add key="pivot" value="https://nuget.pkg.github.com/AnnabiGihed/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="pivot">
      <package pattern="Pivot.Framework.*" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
  <packageSourceCredentials>
    <pivot>
      <add key="Username" value="%PIVOT_PACKAGES_USER%" />
      <add key="ClearTextPassword" value="%PIVOT_PACKAGES_TOKEN%" />
    </pivot>
  </packageSourceCredentials>
</configuration>
